# Copy to backend/.env for local backend configuration. Never commit a real .env file.
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000"]
PROVIDER_TIMEOUT_SECONDS=8
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=512
LOG_LEVEL=INFO
OPEN_METEO_BASE_URL=https://api.open-meteo.com
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_BASE_URL=https://api.data.gov.in
MARKET_CACHE_TTL_SECONDS=900
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_TIMEOUT_SECONDS=20
ASSISTANT_MAX_HISTORY=10
ASSISTANT_MAX_TOOL_ITERATIONS=2
ASSISTANT_REQUEST_BODY_LIMIT_BYTES=32768
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RAG_STORE_PATH=../knowledge-base/chroma
RAG_DOCUMENTS_PATH=../knowledge-base/documents.json
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.72
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MAX_CONTEXT_CHARS=6000
